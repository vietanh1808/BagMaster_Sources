    m_values:
    - localizedString: 'Oinking: That’s my distant cousin’s cave. He’s ridiculously rich.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: Watch out for his <color=orange>SLAP!</color> He once slaped a dinosaur so hard it flew back to prehistoric times.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'OInking: Doesn’t matter. Just defeat him before he gets close enough to touch you.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: Noooo!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: Haha, noob.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: Look like you know what to do now, I will hide on bush and judge you from afar, hehe.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: ... You stole my artifact ... to summon this...'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: KIDD !!?????'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: What a joke'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: Wellllll, may be it''s a bug?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: But hey, HE got the job done.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: Interesting indeed...'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: Let''s see if he really worth it !!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: Don''t worry Kid, I won''t take you seriously'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: Let''s call this ... a test!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: That''s his famous hell trident !!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: <i>But going all out from the beginning would be kinda lame.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: <i>I mean, I''m the mighty boss, after all.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: <i>And Hell Trident cost a lot of Mana to use anyway.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: The oink he''s yapping about?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Oinking: Let''s beat it while he''s busy yapping, Kid'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: .....'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Red: RUDE !!!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
  _containsLocalizedAssets: 0
  _usesAddressableAssets: 0
