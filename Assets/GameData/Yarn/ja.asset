  m_EditorHideFlags: 0
  m_Script: {fileID: -1614657691, guid: 3bf1220806ee46cade57e0f0656425d5, type: 3}
  m_Name: ja
  m_EditorClassIdentifier:
  entries:
    m_keys:
    - line:019b5d1
    - line:04faf89
    - line:0b8271b
