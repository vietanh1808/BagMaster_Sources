    m_values:
    - localizedString: '꿀꿀왕: 이건 내 먼 친척의 동굴이야. 어마어마하게 부자지.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 그의 <color=orange>귀싸대기</color> 공격을 조심해! 한번은 공룡의 귀싸대기를 날렸는데, 너무 세서 원시 시대로 날아갔다더라.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 상관없지. 그냥 닿을 정도로 가까워지기 전에 쓰러뜨려.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 안 돼애애!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 하하, 허접.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 이제 알아서 잘 할 것 같네. 난 저 멀리 덤불에 숨어서 너 평가질이나 할게... 헤헤.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ...내 유물을 훔쳐가서... 소환한 게 고작 이거냐?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 꼬맹이!!?????'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 웃기지도 않는군.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 으으음... 버그인가?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 그래도 맡은 일은 해냈잖아.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 흥미롭군...'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 실력이 어느 정도인지 볼까!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 걱정 마라, 꼬맹이. 진심으로 상대하진 않을 테니.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 뭐... 시험이라고 치자!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 악명 높은 지옥 삼지창이야!!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>하지만 처음부터 전력을 다하는 건 조금 찌질하지.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>나는 막강한 보스잖아.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>그리고 어차피 지옥 삼지창을 쓰려면 마나가 엄청 든다고.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 뭐라고 떠드는 거야, 꿀꿀?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '꿀꿀왕: 얘, 말하느라 바쁠 때 공격하자!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: .....'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 무례하구나!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
  _containsLocalizedAssets: 0
  _usesAddressableAssets: 0
