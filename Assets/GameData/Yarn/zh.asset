    - line:0a11ddd
    - line:0594148
    - line:067c4f9
    - line:07d37de
    - line:0ff2e43
    m_values:
    - localizedString: '哼唧唧: 那是我远房表亲的洞穴。他富得离谱。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 小心他的<color=orange>头槌！</color>他曾一下把恐龙撞回了史前时代。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 无所谓。在他靠近你之前把他干掉就行。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 不——！！！'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 哈哈，菜鸟。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 看来你知道该做什么了。我就躲在草丛里远远看着，对你评头论足吧……嘿嘿。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ……你偷了我的神器……就为了召唤这个？'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 小鬼？！？'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 真是笑话。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 好吧……也许是个漏洞？'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 不过嘛，他确实把事情办成了。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 有点意思……'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 看看他到底值不值得！！'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 别担心，小鬼——我不会认真对付你的。'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 就当这是……一场测试吧！'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 那是他著名的地狱三叉戟！！！！'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>不过一上来就全力以赴也太无聊了。</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>再说了，我可是强大的头目。</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>而且使用地狱三叉戟要消耗大量法力。</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 他发出的哼哼声？'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '哼唧唧: 趁他还在废话的时候狠狠干掉它，小鬼！'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: .....'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: 没礼貌！！！'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
  _containsLocalizedAssets: 0
  _usesAddressableAssets: 0
