    - line:0ff2e43
    m_values:
    - localizedString: 'Рохкороль: Це печера мого кузена. Він неймовірно багатий.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Стережися його <color=orange>УДАРУ</color>! Одного разу він так сильно вдарив динозавра, що той полетів назад у доісторичні часи.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Не зважай. Просто переможи його, перш ніж він підійде достатньо близько, щоб доторкнутися до тебе.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Ні-і-і-і!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Ха-ха, нубло.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Здається, ти тепер знаєш, що робити. Я сховаюся в кущах і буду судити здалеку... хе-хе.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ...Ти вкрав мій артефакт... щоб викликати це?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ЦЕЙ МАЛЮК?!?!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Що за жарт.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Ну-у-у-у... може, це жук?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Але ж він таки виконав роботу.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Цікаво...'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Побачимо, чи він справді цього вартий!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Не хвилюйся, малюче, — я не сприйматиму тебе надто серйозно.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Назвімо це... тестуванням!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Це його знаменитий Пекельний тризуб!!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>Але викладатися на повну від самого початку було б трохи нерозумно.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>Тобто, зрештою, я ж могутній бос.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>А використання Пекельного тризуба однаково коштує купу мани.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Це те рохкання, про яке він там теревенить?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'Рохкороль: Валимо звідси, поки він зайнятий своїми балачками, малюче!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: .....'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ЦЕ ГРУБО!!!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
  _containsLocalizedAssets: 0
  _usesAddressableAssets: 0
