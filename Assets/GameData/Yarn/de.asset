    m_values:
    - localizedString: 'König Grunz: Das ist die Höhle meines entfernten Cousins. Er ist unverschämt reich.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Pass auf, dass er dich nicht mit seiner <color=orange>KOPFNUSS</color> erwischt! Einmal hat er einen Dino damit zurück in die prähistorische Zeit katapultiert.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Aber egal. Besieg ihn einfach, bevor er nah genug an dich herankommt, um dir zu schaden.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Neiiiiin!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Haha, Grünschnabel.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Sieht so aus, als wüsstest du jetzt, was zu tun ist. Ich werde mich in einem Busch verstecken und dich aus der Ferne beurteilen ... hehe.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ... Du hast mein Artefakt gestohlen ... nur, um dieses ...'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: ... KIND zu rufen?!?!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Was für eine Lachnummer.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Tjaaaa ... vielleicht ist es ein Bug?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Aber hey, er hat die Sache erledigt.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Interessant ...'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Mal sehen, ob er wirklich würdig ist!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Keine Sorge, Kind – ich werde dich nicht allzu ernst nehmen.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Nennen wir das ... einen Test!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Das ist der berühmte Höllendreizack!!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>Aber am Anfang schon alles zu geben, wäre wohl wenig überzeugend.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>Ich meine, ich bin schließlich der mächtige Boss.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: <i>Und die Verwendung des Höllendreizacks kostet haufenweise Mana.</i>'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Wovon zum Grunz redet der da?'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: 'König Grunz: Machen wir ihn fertig, solange er noch am Quasseln ist, Kind.'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: .....'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
    - localizedString: '???: Wie UNHÖFLICH!!!!!'
      localizedAsset: {fileID: 0}
      localizedAssetReference:
        m_AssetGUID:
        m_SubObjectName:
        m_SubObjectType:
  _containsLocalizedAssets: 0
  _usesAddressableAssets: 0
